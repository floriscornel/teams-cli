.nh
.TH "TEAMS" "1" "Oct 2026" "teams dev" "teams Manual"

.SH NAME
teams-calendar-cancel - Cancel a meeting you organize


.SH SYNOPSIS
\fBteams calendar cancel  [flags]\fP


.SH DESCRIPTION
Cancel a meeting. Only the organizer can cancel; use \fBteams calendar
decline\fR to turn down an invitation instead.

.PP
Your attendees are told the meeting is cancelled.


.SH OPTIONS
\fB--comment\fP=""
	message to send to the attendees

.PP
\fB--dry-run\fP[=false]
	print the Graph request without sending it

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for cancel

.PP
\fB--yes\fP[=false]
	skip the confirmation prompt


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--jq\fP=""
	filter JSON output through a jq expression (implies --json)

.PP
\fB--json\fP[=false]
	machine-readable JSON output

.PP
\fB--no-color\fP[=false]
	disable colours (also honours NO_COLOR)

.PP
\fB--no-input\fP[=false]
	never prompt; fail fast instead

.PP
\fB--profile\fP=""
	profile to use (default: the configured default_profile)

.PP
\fB--quiet\fP[=false]
	suppress progress messages on stderr

.PP
\fB--read-only\fP[=false]
	refuse write commands

.PP
\fB--refresh\fP[=false]
	ignore cached names and resolve them again

.PP
\fB-v\fP, \fB--verbose\fP[=0]
	verbose diagnostics on stderr (-v, -vv)


.SH SEE ALSO
\fBteams-calendar(1)\fP
