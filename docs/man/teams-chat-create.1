.nh
.TH "TEAMS" "1" "Oct 2026" "teams dev" "teams Manual"

.SH NAME
teams-chat-create - Create a group chat or a one-on-one chat


.SH SYNOPSIS
\fBteams chat create --with  [--with …] [--topic ] [flags]\fP


.SH DESCRIPTION
Create a chat. --with names the other participants (repeatable); you are added
automatically. One participant makes a one-on-one chat, which the API returns
from its cache when that chat already exists; two or more make a group chat,
where --topic is allowed.


.SH OPTIONS
\fB--dry-run\fP[=false]
	print the Graph request without sending it

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--topic\fP=""
	title of the chat (group chats only)

.PP
\fB--with\fP=[]
	person to include (repeatable): @name, an e-mail address or a user id


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--jq\fP=""
	filter JSON output through a jq expression (implies --json)

.PP
\fB--json\fP[=false]
	machine-readable JSON output

.PP
\fB--no-color\fP[=false]
	disable colours (also honours NO_COLOR)

.PP
\fB--no-input\fP[=false]
	never prompt; fail fast instead

.PP
\fB--profile\fP=""
	profile to use (default: the configured default_profile)

.PP
\fB--quiet\fP[=false]
	suppress progress messages on stderr

.PP
\fB--read-only\fP[=false]
	refuse write commands

.PP
\fB--refresh\fP[=false]
	ignore cached names and resolve them again

.PP
\fB-v\fP, \fB--verbose\fP[=0]
	verbose diagnostics on stderr (-v, -vv)


.SH SEE ALSO
\fBteams-chat(1)\fP
