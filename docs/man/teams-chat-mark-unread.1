.TH "TEAMS" "1" "Oct 2026" "teams dev" "teams Manual"

.SH NAME
teams-chat-mark-unread - Mark a chat unread


.SH SYNOPSIS
\fBteams chat mark-unread  [flags]\fP


.SH DESCRIPTION
Move your own read watermark for a chat.

.PP
Graph stores it in the chat's viewpoint, which is what \fBteams unread\fR and
\fBteams chat list --unread\fR read back
(refs/graph/api-reference/v1.0/resources/chatviewpoint.md).


.SH OPTIONS
\fB--dry-run\fP[=false]
	print the Graph request without sending it

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for mark-unread


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--jq\fP=""
	filter JSON output through a jq expression (implies --json)

.PP
\fB--json\fP[=false]
	machine-readable JSON output

.PP
\fB--no-color\fP[=false]
	disable colours (also honours NO_COLOR)

.PP
\fB--no-input\fP[=false]
	never prompt; fail fast instead

.PP
\fB--profile\fP=""
	profile to use (default: the configured default_profile)

.PP
\fB--quiet\fP[=false]
	suppress progress messages on stderr

.PP
\fB--read-only\fP[=false]
	refuse write commands

.PP
\fB--refresh\fP[=false]
	ignore cached names and resolve them again

.PP
\fB-v\fP, \fB--verbose\fP[=0]
	verbose diagnostics on stderr (-v, -vv)


.SH SEE ALSO
\fBteams-chat(1)\fP
