# Read-only mode allows every read command; the person form of a chat reference
# resolves through the members scan, which is a read (PLAN.md:166).
env TEAMS_ACCESS_TOKEN=eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0..

exec teams --read-only team list
stdout 'Engineering'

exec teams --read-only channel read Engineering/General --limit 1
stdout 'Hello @Yuki Tanaka'

exec teams --read-only chat read @bob
stdout 'lunch?'

exec teams --read-only search deploy
stdout 'deploy notes'
