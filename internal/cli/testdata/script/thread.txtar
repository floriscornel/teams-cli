# thread read: a channel thread, a chat message and the link forms.
env TEAMS_ACCESS_TOKEN=eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0..

exec teams thread read Engineering/General/m-1002
stdout 'Deploy'
stdout 'Hello @Yuki Tanaka'
stdout 'On it.'

# The documented channel-message link (deep-link-teams.md).
exec teams thread read 'https://teams.microsoft.com/l/message/19:general@thread.tacv2/m-1002?tenantId=11111111-2222-3333-4444-555555555555&groupId=team-eng&parentMessageId=m-1002&teamName=Engineering&channelName=General&createdTime=1758000000000'
stdout 'Hello @Yuki Tanaka'
stdout 'On it.'

# A link to a reply walks up to its thread root.
exec teams thread read 'https://teams.microsoft.com/l/message/19:general@thread.tacv2/m-1003?groupId=team-eng&parentMessageId=m-1002'
stdout 'Hello @Yuki Tanaka'
stdout 'On it.'

exec teams thread read Engineering/General/m-1002 --json --jq '.replies[0].id'
stdout '^m-1003$'

# A chat message link: the query string is the discriminator (PLAN.md:161).
exec teams thread read 'https://teams.microsoft.com/l/message/19:bob@thread.v2/c-2?context=%7B%22contextType%22%3A%22chat%22%7D'
stderr 'chats have no threads'
stdout 'sure, at 12'

# A bare message id cannot be located without its container.
! exec teams thread read m-1002
stderr 'does not identify a message'
