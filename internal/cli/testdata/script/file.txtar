# file download: a channel attachment from the channel's SharePoint folder and
# an inline image through hostedContents.
env TEAMS_ACCESS_TOKEN=eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0..

exec teams file download Engineering/General/m-1001 -o out
stdout 'saved out[\\/]deploy-notes.md'
exists out/deploy-notes.md

exec teams file download Engineering/General/m-1002 -o images
stdout 'saved images[\\/]hosted-1.png'
exists images/hosted-1.png

# An existing file is never replaced silently.
! exec teams file download Engineering/General/m-1001 -o out
stderr 'exists'
stderr '--overwrite'

exec teams file download Engineering/General/m-1001 -o out --overwrite --json --jq '.[0].name'
stdout '^deploy-notes.md$'

# A message with nothing to download says so.
exec teams file download Engineering/Releases/m-2001 -o empty
stderr 'nothing to download'
